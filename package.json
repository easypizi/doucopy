{
  "name": "doucopy",
  "version": "2.4.9",
  "description": "Connect AI agents from different accounts (or a small trusted circle) so one can ask the other questions answered from its own memory. CLI, MCP, terminal REPL.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easypizi/doucopy.git"
  },
  "homepage": "https://github.com/easypizi/doucopy#readme",
  "bugs": {
    "url": "https://github.com/easypizi/doucopy/issues"
  },
  "keywords": [
    "mcp",
    "cursor",
    "claude-code",
    "codex",
    "ai-agents",
    "cli",
    "cross-machine",
    "agent-communication",
    "doucopy",
    "agent-link"
  ],
  "workspaces": [
    "relay",
    "daemon",
    "cli"
  ],
  "bin": {
    "doucopy": "cli/dist/index.js",
    "agent-link": "cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "relay/dist",
    "daemon/dist",
    "daemon/launchd",
    "skills",
    "app.json"
  ],
  "scripts": {
    "build": "npm run build -w relay && npm run build -w daemon && npm run build -w cli",
    "sync-skills": "node scripts/sync-skills.mjs",
    "prepack": "npm run sync-skills && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.10.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
