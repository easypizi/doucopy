{
  "name": "agent-link",
  "private": true,
  "description": "Connect AI agents from different accounts so one can ask the other questions answered from its own memory",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "relay",
    "daemon"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "daemon:install": "bash scripts/daemon.sh install",
    "daemon:start": "bash scripts/daemon.sh start",
    "daemon:stop": "bash scripts/daemon.sh stop",
    "daemon:restart": "bash scripts/daemon.sh restart",
    "daemon:status": "bash scripts/daemon.sh status",
    "daemon:logs": "bash scripts/daemon.sh logs",
    "daemon:rebuild": "bash scripts/daemon.sh rebuild",
    "daemon:uninstall": "bash scripts/daemon.sh uninstall"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
